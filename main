#!/bin/bash

#SBATCH --job-name=anatomix-t1w-dwi-reg
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.
#
# GPU strongly recommended: this container has no fused CUDA kernels built
# (see docker-build/Dockerfile in the anatomix source repo), so FireANTs runs
# its pure-PyTorch path -- correct on CPU, but registration is slow without a
# GPU. `--nv` passes the host's NVIDIA driver into the container.

set -e

mkdir -p out_dir b0_reg warp

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

singularity exec --nv -e docker://gamorosino/anatomix-fireants:latest python3 main.py

[ -z "$(ls -A b0_reg)" ] && echo "no b0_reg output produced" && exit 1
[ -z "$(ls -A warp)" ] && echo "no warp output produced" && exit 1
exit 0
